				<string>export PYTHONPATH="$PWD"
run() { nohup /usr/bin/python3 -m kobold "$@" --notify &gt;/dev/null 2&gt;&amp;1 &amp; }
case "$action" in
  update) run update; echo "Rebuilding the index… a notification follows";;
  fix) run fix "$1"; echo "Fixing… a notification follows";;
  undo) run undo; echo "Undoing the last batch… a notification follows";;
  nook) run nook "$1"; echo "To the nook… a notification follows";;
  done) run done "$1"; echo "Filing away… a notification follows";;
  remove) run remove "$1"; echo "Moving to _trash/… a notification follows";;
  import) run import "$1"; echo "Importing… a notification follows";;
  genre) run genre "$book" "$1"; echo "Setting the genre… a notification follows";;
  ask) run ask "" "$1"; echo "Asking the model… a notification follows";;
  embed) run embed; echo "Embedding… a notification follows";;
esac</string>
